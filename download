import { useState, useEffect, useRef } from "react";
import { useQuery, useMutation } from "@tanstack/react-query";
import { apiRequest, queryClient } from "@/lib/queryClient";
import { useToast } from "@/hooks/use-toast";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Badge } from "@/components/ui/badge";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import {
  ChevronLeft,
  ChevronRight,
  Star,
  Check,
  SkipForward,
  BookOpen,
  Sparkles,
  Loader2,
} from "lucide-react";
import type { Case } from "@shared/schema";
import { useQuery as useSessionsQuery } from "@tanstack/react-query";
import type { Session } from "@shared/schema";

function courseAbbrev(courseName: string | null | undefined): string {
  if (!courseName) return "";
  // Take consecutive uppercase letters from the start (e.g. "FRC", "TEM", "LEAD")
  const upper = courseName.match(/\b[A-Z]{2,}/g);
  if (upper) return upper[0].slice(0, 4);
  // Fallback: first letters of each word, max 4
  return courseName.split(/\s+/).map(w => w[0]?.toUpperCase() ?? "").join("").slice(0, 4);
}

function caseId(cas: Case, sessions: Session[]): string {
  const abbrev = courseAbbrev(cas.courseName);
  // Find linked session for sessionNumber
  const session = sessions.find(s => s.caseId === cas.id);
  const num = session?.sessionNumber ?? cas.orderIndex ?? 0;
  if (!abbrev) return String(num + 1).padStart(2, "0");
  return `${abbrev}${String(num).padStart(2, "0")}`;
}

const INDUSTRIES = [
  "Technology", "Finance", "Healthcare", "Energy", "Retail",
  "Manufacturing", "Media", "Real Estate", "Education",
  "Government", "Nonprofit", "Consulting", "Other",
];

const GEOGRAPHIES = [
  "United States", "Europe", "China", "India", "Japan",
  "Latin America", "Africa", "Middle East", "Southeast Asia",
  "Global", "Other",
];

const PROMPTS = [
  "What was the core decision or tension in this case?",
  "What framework or concept was this case teaching?",
  "What surprised you or changed how you think?",
  "If you had to explain this case in one sentence to a friend, what would you say?",
  "What's the one thing you'd remember from this case in 5 years?",
];

export default function CataloguePage() {
  const { toast } = useToast();
  const [currentIndex, setCurrentIndex] = useState(0);
  const [filter, setFilter] = useState<"all" | "pending" | "completed">("pending");
  const [promptIndex, setPromptIndex] = useState(0);
  const [generatingFor, setGeneratingFor] = useState<number | null>(null);
  const textareaRef = useRef<HTMLTextAreaElement>(null);

  const { data: sessions = [] } = useSessionsQuery<Session[]>({
    queryKey: ["/api/sessions"],
    queryFn: () => apiRequest("GET", "/api/sessions").then(r => r.json()),
  });

  const { data: allCases = [], isLoading } = useQuery<Case[]>({
    queryKey: ["/api/cases"],
    queryFn: () => apiRequest("GET", "/api/cases").then((r) => r.json()),
  });

  const filteredCases = allCases.filter((c) => {
    if (filter === "pending") return c.status !== "completed";
    if (filter === "completed") return c.status === "completed";
    return true;
  });

  const currentCase = filteredCases[currentIndex];

  // Reset index when filter changes
  useEffect(() => {
    setCurrentIndex(0);
  }, [filter]);

  // Rotate prompt
  useEffect(() => {
    setPromptIndex(Math.floor(Math.random() * PROMPTS.length));
  }, [currentIndex]);

  const updateMutation = useMutation({
    mutationFn: async ({ id, data }: { id: number; data: Partial<Case> }) => {
      const resp = await apiRequest("PATCH", `/api/cases/${id}`, data);
      return resp.json();
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["/api/cases"] });
      queryClient.invalidateQueries({ queryKey: ["/api/stats"] });
    },
  });

  const handleFieldUpdate = (field: string, value: any) => {
    if (!currentCase) return;
    updateMutation.mutate({ id: currentCase.id, data: { [field]: value } });
  };

  const handleComplete = () => {
    if (!currentCase) return;
    updateMutation.mutate(
      { id: currentCase.id, data: { status: "completed" } },
      {
        onSuccess: () => {
          toast({ title: "Done", description: `"${currentCase.title}" catalogued.` });
          // Move to next case
          if (currentIndex < filteredCases.length - 1) {
            // Stay at same index since current will be removed from pending filter
          } else if (currentIndex > 0) {
            setCurrentIndex(currentIndex - 1);
          }
        },
      }
    );
  };

  const handleSkip = () => {
    if (currentIndex < filteredCases.length - 1) {
      setCurrentIndex(currentIndex + 1);
    }
  };

  const handleStar = () => {
    if (!currentCase) return;
    handleFieldUpdate("starred", currentCase.starred === 1 ? 0 : 1);
  };

  const handleGenerateTakeaways = async () => {
    if (!currentCase) return;
    const session = sessions.find(s => s.caseId === currentCase.id);
    if (!session) {
      toast({ title: "No session linked to this case", description: "Import files first to generate insights.", variant: "destructive" });
      return;
    }
    setGeneratingFor(currentCase.id);
    try {
      const res = await fetch(`/api/sessions/${session.id}/generate-insights`, { method: "POST" });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      toast({ title: `${data.insights?.length ?? 0} insights generated`, description: "Open the Journal to review them." });
    } catch (err: any) {
      toast({ title: "Failed", description: err.message, variant: "destructive" });
    } finally {
      setGeneratingFor(null);
    }
  };

  if (isLoading) {
    return (
      <div className="flex items-center justify-center h-full">
        <p className="text-sm text-muted-foreground">Loading cases...</p>
      </div>
    );
  }

  if (allCases.length === 0) {
    return (
      <div className="flex flex-col items-center justify-center h-full gap-4 text-center p-6">
        <BookOpen className="w-12 h-12 text-muted-foreground/50" />
        <div>
          <h2 className="text-lg font-semibold">No cases yet</h2>
          <p className="text-sm text-muted-foreground mt-1">
            Head to Upload to add your cases first.
          </p>
        </div>
      </div>
    );
  }

  if (filteredCases.length === 0) {
    return (
      <div className="flex flex-col items-center justify-center h-full gap-4 text-center p-6">
        <Check className="w-12 h-12 text-primary/50" />
        <div>
          <h2 className="text-lg font-semibold">All done</h2>
          <p className="text-sm text-muted-foreground mt-1">
            You've catalogued all your cases. Switch to "All" to review them.
          </p>
        </div>
        <Button variant="secondary" onClick={() => setFilter("all")}>
          Show all cases
        </Button>
      </div>
    );
  }

  return (
    <div className="max-w-3xl mx-auto p-6 space-y-4">
      {/* Header row */}
      <div className="flex items-center justify-between gap-4">
        <div>
          <h1 className="text-xl font-bold" data-testid="text-catalogue-title">
            Catalogue
          </h1>
          <p className="text-xs text-muted-foreground mt-0.5">
            Case {currentIndex + 1} of {filteredCases.length}
          </p>
        </div>
        <div className="flex gap-1 bg-muted p-1 rounded-md">
          {(["pending", "completed", "all"] as const).map((f) => (
            <button
              key={f}
              onClick={() => setFilter(f)}
              className={`px-2.5 py-1 text-xs rounded-md transition-colors capitalize ${
                filter === f
                  ? "bg-background font-medium"
                  : "text-muted-foreground"
              }`}
              data-testid={`button-filter-${f}`}
            >
              {f} {f === "pending" && `(${allCases.filter((c) => c.status !== "completed").length})`}
              {f === "completed" && `(${allCases.filter((c) => c.status === "completed").length})`}
            </button>
          ))}
        </div>
      </div>

      {/* Progress bar */}
      <div className="h-1 bg-muted rounded-full overflow-hidden">
        <div
          className="h-full bg-primary rounded-full transition-all duration-300"
          style={{
            width: `${Math.round(
              (allCases.filter((c) => c.status === "completed").length /
                allCases.length) *
                100
            )}%`,
          }}
        />
      </div>

      {/* Main card */}
      {currentCase && (
        <Card key={currentCase.id}>
          <CardContent className="p-6 space-y-5">
            {/* Title + star */}
            <div className="flex items-start justify-between gap-3">
              <div className="flex-1">
                <div className="flex items-center gap-2 mb-1 flex-wrap">
                  {currentCase.courseName && (
                    <Badge variant="secondary">{currentCase.courseName}</Badge>
                  )}
                  {currentCase.semester && (
                    <Badge variant="outline">{currentCase.semester}</Badge>
                  )}
                  {currentCase.status === "completed" && (
                    <Badge className="bg-primary/10 text-primary">Completed</Badge>
                  )}
                </div>
                <Input
                  value={currentCase.title}
                  onChange={(e) => handleFieldUpdate("title", e.target.value)}
                  className="text-lg font-semibold border-0 px-0 focus-visible:ring-0 bg-transparent"
                  data-testid="input-case-title"
                />
              </div>
              <div className="flex gap-1">
                <Button
                  size="icon"
                  variant="ghost"
                  onClick={handleGenerateTakeaways}
                  disabled={generatingFor === currentCase.id}
                  title="Generate AI takeaways"
                >
                  {generatingFor === currentCase.id
                    ? <Loader2 className="w-4 h-4 animate-spin text-muted-foreground" />
                    : <Sparkles className="w-4 h-4 text-muted-foreground" />
                  }
                </Button>
                <Button
                  size="icon"
                  variant="ghost"
                  onClick={handleStar}
                  data-testid="button-star"
                >
                  <Star
                    className={`w-5 h-5 ${
                      currentCase.starred === 1
                        ? "fill-yellow-400 text-yellow-400"
                        : "text-muted-foreground"
                    }`}
                  />
                </Button>
              </div>
            </div>

            {/* Metadata row */}
            <div className="grid grid-cols-2 gap-3">
              <div>
                <label className="text-xs font-medium text-muted-foreground mb-1 block">
                  Course
                </label>
                <Input
                  value={currentCase.courseName || ""}
                  onChange={(e) => handleFieldUpdate("courseName", e.target.value)}
                  placeholder="Course name"
                  data-testid="input-course-name"
                />
              </div>
              <div>
                <label className="text-xs font-medium text-muted-foreground mb-1 block">
                  Semester
                </label>
                <Select
                  value={currentCase.semester || ""}
                  onValueChange={(v) => handleFieldUpdate("semester", v)}
                >
                  <SelectTrigger data-testid="select-semester">
                    <SelectValue placeholder="Semester" />
                  </SelectTrigger>
                  <SelectContent>
                    {["RC Fall", "RC Spring", "EC Fall", "EC Spring"].map((s) => (
                      <SelectItem key={s} value={s}>{s}</SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>
              <div>
                <label className="text-xs font-medium text-muted-foreground mb-1 block">
                  Industry
                </label>
                <Select
                  value={currentCase.industry || ""}
                  onValueChange={(v) => handleFieldUpdate("industry", v)}
                >
                  <SelectTrigger data-testid="select-industry">
                    <SelectValue placeholder="Industry" />
                  </SelectTrigger>
                  <SelectContent>
                    {INDUSTRIES.map((i) => (
                      <SelectItem key={i} value={i}>{i}</SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>
              <div>
                <label className="text-xs font-medium text-muted-foreground mb-1 block">
                  Geography
                </label>
                <Select
                  value={currentCase.geography || ""}
                  onValueChange={(v) => handleFieldUpdate("geography", v)}
                >
                  <SelectTrigger data-testid="select-geography">
                    <SelectValue placeholder="Geography" />
                  </SelectTrigger>
                  <SelectContent>
                    {GEOGRAPHIES.map((g) => (
                      <SelectItem key={g} value={g}>{g}</SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>
            </div>

            {/* One-liner */}
            <div>
              <label className="text-xs font-medium text-muted-foreground mb-1 block">
                One-line summary
              </label>
              <Input
                value={currentCase.oneLiner || ""}
                onChange={(e) => handleFieldUpdate("oneLiner", e.target.value)}
                placeholder="What happened / what's the decision?"
                data-testid="input-one-liner"
              />
            </div>

            {/* Key framework */}
            <div>
              <label className="text-xs font-medium text-muted-foreground mb-1 block">
                Key framework or concept
              </label>
              <Input
                value={currentCase.keyFramework || ""}
                onChange={(e) => handleFieldUpdate("keyFramework", e.target.value)}
                placeholder="e.g. NPV, disruptive innovation, BATNA..."
                data-testid="input-framework"
              />
            </div>

            {/* Takeaways — the main dictation area */}
            <div>
              <div className="flex items-center justify-between mb-1">
                <label className="text-xs font-medium text-muted-foreground">
                  Your takeaways
                </label>
                <span className="text-xs text-primary/70 italic">
                  {PROMPTS[promptIndex]}
                </span>
              </div>
              <Textarea
                ref={textareaRef}
                value={currentCase.takeaways || ""}
                onChange={(e) => handleFieldUpdate("takeaways", e.target.value)}
                placeholder="Dictate or type your thoughts here... WispFlow will transcribe your speech into this field."
                rows={5}
                className="text-sm"
                data-testid="textarea-takeaways"
              />
            </div>

            {/* Tags */}
            <div>
              <label className="text-xs font-medium text-muted-foreground mb-1 block">
                Tags (comma-separated)
              </label>
              <Input
                value={
                  currentCase.tags
                    ? (() => {
                        try { return JSON.parse(currentCase.tags).join(", "); }
                        catch { return currentCase.tags; }
                      })()
                    : ""
                }
                onChange={(e) => {
                  const tags = e.target.value.split(",").map((t) => t.trim()).filter(Boolean);
                  handleFieldUpdate("tags", JSON.stringify(tags));
                }}
                placeholder="e.g. energy, leadership, pricing..."
                data-testid="input-tags"
              />
            </div>

            {/* Action buttons */}
            <div className="flex items-center justify-between pt-2 border-t">
              <div className="flex gap-2">
                <Button
                  variant="ghost"
                  size="sm"
                  disabled={currentIndex === 0}
                  onClick={() => setCurrentIndex(currentIndex - 1)}
                  data-testid="button-prev"
                >
                  <ChevronLeft className="w-4 h-4 mr-1" />
                  Prev
                </Button>
                <Button
                  variant="ghost"
                  size="sm"
                  disabled={currentIndex >= filteredCases.length - 1}
                  onClick={handleSkip}
                  data-testid="button-skip"
                >
                  Skip
                  <SkipForward className="w-4 h-4 ml-1" />
                </Button>
              </div>
              <div className="flex gap-2">
                <Button
                  variant="ghost"
                  size="sm"
                  disabled={currentIndex >= filteredCases.length - 1}
                  onClick={() => setCurrentIndex(currentIndex + 1)}
                  data-testid="button-next"
                >
                  Next
                  <ChevronRight className="w-4 h-4 ml-1" />
                </Button>
                <Button
                  size="sm"
                  onClick={handleComplete}
                  disabled={updateMutation.isPending}
                  data-testid="button-complete"
                >
                  <Check className="w-4 h-4 mr-1" />
                  Mark done
                </Button>
              </div>
            </div>
          </CardContent>
        </Card>
      )}

      {/* Quick jump */}
      <div className="flex flex-wrap gap-1.5 pt-2">
        {filteredCases.map((c, i) => {
          const id = caseId(c, sessions);
          return (
            <button
              key={c.id}
              onClick={() => setCurrentIndex(i)}
              className={`px-2 h-7 text-[10px] font-mono rounded-md border transition-colors ${
                i === currentIndex
                  ? "bg-primary text-primary-foreground border-primary"
                  : c.status === "completed"
                  ? "bg-primary/10 border-primary/20 text-primary"
                  : "bg-background border-border text-muted-foreground"
              }`}
              title={c.title}
              data-testid={`button-jump-${c.id}`}
            >
              {id}
            </button>
          );
        })}
      </div>
    </div>
  );
}
