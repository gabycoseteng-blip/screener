# ---------------------------------------------------------------------------
# Equity Idea Aggregator — environment variables
# Copy to `.env` for local dev; set the same keys in the Vercel dashboard.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon, Supabase, RDS, or local). Required.
DATABASE_URL=postgres://user:password@host:5432/equity_ideas

# --- Anthropic (LLM scoring) -----------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides (defaults live in config/pipeline.ts)
# TRIAGE_MODEL=claude-haiku-4-5-20251001
# SCORING_MODEL=claude-sonnet-4-6

# --- Reddit (script app: https://www.reddit.com/prefs/apps) ----------------
# OPTIONAL since Reddit gated new keys behind its Responsible Builder Policy:
# if CLIENT_ID/SECRET are unset, the pipeline falls back to the public
# /r/<sub>/top.json endpoints (no auth; stricter rate limits, datacenter IPs
# occasionally blocked). Add real credentials once your application is approved.
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
# A descriptive, unique UA avoids 429/403 in either mode.
REDDIT_USER_AGENT=equity-idea-aggregator/0.1 by your_reddit_username

# --- Financial Modeling Prep (ticker validation + sector + prices) ---------
FMP_API_KEY=...

# --- Cron protection -------------------------------------------------------
# Random secret. Vercel Cron sends it automatically; manual calls must match.
CRON_SECRET=change-me-to-a-long-random-string

# --- Optional: Slack daily summary -----------------------------------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Optional: Notion review mirror (off unless both are set) --------------
# NOTION_API_KEY=secret_...
# NOTION_DATABASE_ID=...
